# ==============================================================================
# ShopFinder Backend Environment Configuration Template
# DO NOT put real secrets or credentials in this file.
# Copy this file to .env and configure environment-specific values.
# ==============================================================================

# Node Environment: development | test | production
NODE_ENV=development

# Server Port (default: 4000)
PORT=4000

# Allowed Frontend Client Origin for CORS and Cookie Credentials (e.g. http://localhost:5173)
# Note: Wildcard (*) is strictly forbidden when credentials are enabled.
CLIENT_URL=http://localhost:5173

# PocketBase Internal Database Connection (Phase 2+)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=your-admin@example.com
POCKETBASE_ADMIN_PASSWORD=replace-with-a-local-secret


